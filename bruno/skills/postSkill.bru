meta {
  name: postSkill
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/v1/skills
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{$randomUUID}}",
    "name": "{{$randomBsAdjective}} {{$randomBsNoun}}",
    "description": "{{$randomBs}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
